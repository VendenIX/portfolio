---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
        {% endif %}

        {% if page.profile.carousel and page.profile.carousel_images %}
          <div class="cv-carousel" data-interval="{{ page.profile.carousel_interval | default: 3500 }}">
            {% for img in page.profile.carousel_images %}
              <img
                src="{{ img.path | prepend: 'assets/img/' | relative_url }}"
                class="{{ profile_image_class }} cv-carousel-frame{% if forloop.first %} is-active{% endif %}"
                alt="{{ img.label }}"
                {% if img.duration %}data-duration="{{ img.duration }}"{% endif %}
              >
            {% endfor %}
          </div>
          <div class="cv-carousel-caption">
            {% for img in page.profile.carousel_images %}
              <span class="cv-carousel-label{% if forloop.first %} is-active{% endif %}">{{ img.label }}</span>
            {% endfor %}
          </div>
          <script>
            document.addEventListener('DOMContentLoaded', function () {
              document.querySelectorAll('.cv-carousel').forEach(function (carousel) {
                // guard against double-initialization (e.g. a dev-server live
                // reload re-running this block without a full page navigation)
                // spawning a second, out-of-phase advance() loop that fights
                // the first one over the same frames.
                if (carousel.dataset.cvCarouselInit) return;
                carousel.dataset.cvCarouselInit = '1';

                var frames = carousel.querySelectorAll('.cv-carousel-frame');
                var labels = carousel.parentElement.querySelectorAll('.cv-carousel-label');
                var defaultDelay = parseInt(carousel.dataset.interval, 10) || 3500;
                if (frames.length < 2) return;
                var i = 0;
                function advance() {
                  frames[i].classList.remove('is-active');
                  if (labels[i]) labels[i].classList.remove('is-active');
                  i = (i + 1) % frames.length;
                  var next = frames[i];
                  if (next.src.indexOf('.gif') !== -1) {
                    // GIFs keep animating in the background even while hidden
                    // (opacity: 0), so without this they'd show up mid-loop
                    // instead of replaying from the first frame each time.
                    // Re-assigning the *same* src (rather than cache-busting
                    // with a query string) still restarts the animation in
                    // every major browser, but serves it from cache instead
                    // of re-fetching the whole file over the network every
                    // cycle -- that re-fetch delay was causing a visible
                    // flicker for larger GIFs.
                    var base = next.dataset.baseSrc || next.src;
                    next.dataset.baseSrc = base;
                    next.src = '';
                    next.src = base;
                  }
                  next.classList.add('is-active');
                  if (labels[i]) labels[i].classList.add('is-active');
                  // per-image data-duration (e.g. a GIF that needs longer to
                  // play out) overrides the carousel's default interval
                  var delay = parseInt(next.dataset.duration, 10) || defaultDelay;
                  setTimeout(advance, delay);
                }
                setTimeout(advance, defaultDelay);
              });
            });
          </script>
        {% elsif page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
