@article{andres_explainability_2026,
  abbr={JIIM},
  bibtex_show={true},
  title = {Explainability and Clinical Trust of Deep Learning in Glioblastoma Treatment Efficacy Prediction: A Comprehensive Framework},
  author = {Andres, Romain and Moreau, Noémie N and Dessoude, Loïse and Le Henaff, Loïc and Missohou, Fernand and Stefan, Dinu and Desmonts, Alexis and Herault, Romain and Corroyer-Dulmont, Aurélien},
  year = {2026},
  month = oct,
  journal = {Journal of Imaging Informatics in Medicine},
  doi = {10.1007/s10278-026-02381-5},
  html = {https://doi.org/10.1007/s10278-026-02381-5},
  code = {https://github.com/VendenIX/GBM-Treatment-Response-XAI},
  keywords = {Explainability, Treatment efficacy, Interpretability, GBM, MRI, Deep learning},
  preview = {xai_glioblastoma2025.gif},
  selected = {true},
  note = {Published online 13 October 2026 (open access).},
  abstract = {A multi-layered explainable AI (XAI) pipeline audits a previously developed deep learning model (ResNet-51q) that predicts glioblastoma overall survival from post-operative MRI: visual focus (Grad-CAM, LRP, LIME), feature dependence through input ablation, and the depth at which class information becomes decodable through linear probing. The audit reveals a high-intensity heuristic: hyper-intense pixels at the skull periphery anchor long-term predictions, while the model defaults to short-term based on tumour enhancement in their absence. In a multi-reader, multi-case clinical study (37 patients, 4 readers, 3 phases, 444 observations), AI assistance improved expert accuracy (OR 1.336 with the AI score, OR 1.598 with heatmaps added) without inflating confidence, and the heatmaps were associated with a change in how experts used the AI score and with fewer patients wrongly called long-term survivors.},
}
